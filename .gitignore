# Godot 4+ specific ignores
.godot/
/android/
.vs/

# Build artifacts
bin/
obj/

# Builds
builds/

# Temp files
*.tmp

# Per-machine CVar config (runtime tuning, local tweaks) — not shared.
cvars.txt

# Auto-generated version file
scripts/VersionGenerated.g.cs

#debug output
worldgen_debug/

# Character animation FBX are build-inputs for the baked *_anims.res libraries
# (tools/build_*_anims.gd); the .res is self-contained, so the source FBX are not committed.
assets/models/characters/*/anims/
