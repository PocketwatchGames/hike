# Godot 4+ specific ignores
.godot/
/android/
.vs/

# Build artifacts
bin/
obj/

# Builds
builds/

# Temp files
*.tmp

# Per-machine CVar config (runtime tuning, local tweaks) — not shared.
cvars.txt

# Auto-generated version file
scripts/VersionGenerated.g.cs

#debug output
worldgen_debug/

# Character animation FBX are build-inputs for the baked *_anims.res libraries
# (tools/build_*_anims.gd, PlayerAnimManifest); the .res is self-contained, so the source FBX are not committed.
asset_src/models/characters/*/anims/
resources/data/worlds/test_world/map/painted_world.hike

# LibreOffice/Excel lock files left beside an open .tsv sheet
.~lock.*#
