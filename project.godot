; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hike"
run/main_scene="uid://c46haqwwl2h4s"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dxb3x5124gh5h"

[autoload]

MaterialRegistry="*res://autoloads/material_registry.tscn"
MusicManager="*res://autoloads/music_manager.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="hike"

[editor_plugins]

enabled=PackedStringArray("res://addons/voxel_atlas_stitcher/plugin.cfg", "res://addons/data_ed/plugin.cfg", "res://addons/anim_library_builder/plugin.cfg")

