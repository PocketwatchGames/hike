[sub_resource type="Resource" id="Inline_1"]
script = ExtResource("Script_ScriptVarCondition")
variable = &"festering_man_return"
op = 1
operand = 0

[sub_resource type="Resource" id="Inline_2"]
script = ExtResource("Script_ScriptVarCondition")
variable = &"festering_man_return"
op = 0
operand = 0

[sub_resource type="Resource" id="Inline_3"]
script = ExtResource("Script_SetScriptVarAction")
variable = &"festering_man_return"
op = 0
operand = 1

[sub_resource type="Resource" id="Inline_4"]
script = ExtResource("Script_UnderstandsLanguageCondition")
language = ExtResource("Lang_vyeshal")
threshold = 0.5
below = true

[sub_resource type="Resource" id="Inline_5"]
script = ExtResource("Script_UnderstandsLanguageCondition")
language = ExtResource("Lang_vyeshal")
threshold = 0.5

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("Script_ConversationEntry")
condition = SubResource("Inline_1")
branch = &"greeting"

[sub_resource type="Resource" id="Entry_2"]
script = ExtResource("Script_ConversationEntry")
condition = SubResource("Inline_2")
branch = &"greeting_return"

[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("Script_ConversationEntry")
branch = &"gestures"

[sub_resource type="Resource" id="Line_greeting_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"festering_man_greeting_01"

[sub_resource type="Resource" id="Branch_greeting"]
script = ExtResource("Script_ConversationBranch")
name = &"greeting"
language = ExtResource("Lang_vyeshal")
lines = [SubResource("Line_greeting_1")]
exitGroup = &"language"
isPrimaryGroupEntry = true

[sub_resource type="Resource" id="Line_greeting_return_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"festering_man_greeting_return_01"

[sub_resource type="Resource" id="Branch_greeting_return"]
script = ExtResource("Script_ConversationBranch")
