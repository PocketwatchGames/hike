[resource]
script = ExtResource("Script_ConversationData")
entryBranches = [SubResource("Entry_1"), SubResource("Entry_2"), SubResource("Entry_3")]
branches = [SubResource("Branch_greeting"), SubResource("Branch_greeting_return"), SubResource("Branch_gestures"), SubResource("Branch_convo"), SubResource("Branch_impatient"), SubResource("Branch_where"), SubResource("Branch_clue"), SubResource("Branch_hammer"), SubResource("Branch_cookpot")]
responseGroups = [SubResource("Group_language"), SubResource("Group_mates"), SubResource("Group_topics")]
descriptionLocKey = &"festering_man_description"
