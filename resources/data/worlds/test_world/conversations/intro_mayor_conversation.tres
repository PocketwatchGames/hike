[gd_resource type="Resource" script_class="ConversationData" format=3 uid="uid://cjobgs1asa236"]

[ext_resource type="Script" uid="uid://cr2wgt6ot73qr" path="res://scripts/data/conversation/ConversationData.cs" id="Script_ConversationData"]
[ext_resource type="Script" uid="uid://ce227yp5q1min" path="res://scripts/data/conversation/ConversationBranch.cs" id="Script_ConversationBranch"]
[ext_resource type="Script" uid="uid://clcxqaw418g6o" path="res://scripts/data/conversation/ConversationEntry.cs" id="Script_ConversationEntry"]
[ext_resource type="Script" uid="uid://yrv1dwid3oww" path="res://scripts/data/conversation/ConversationResponse.cs" id="Script_ConversationResponse"]
[ext_resource type="Script" uid="uid://bh2srai2t6pst" path="res://scripts/data/conversation/ConversationResponseGroup.cs" id="Script_ConversationResponseGroup"]
[ext_resource type="Resource" path="res://resources/data/worlds/shared/languages/common.tres" id="Lang_common"]
[ext_resource type="Resource" path="res://resources/data/world_authoring/conversation/conditions/language_incomplete.tres" id="Cond_language_incomplete"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("Script_ConversationEntry")
branch = &"greeting"

[sub_resource type="Resource" id="Branch_greeting"]
script = ExtResource("Script_ConversationBranch")
name = &"greeting"
lineLocKeys = Array[StringName]([&"intro_mayor_greeting_01"])
exitGroup = &"topics"
isPrimaryGroupEntry = true

[sub_resource type="Resource" id="Branch_speak_common"]
script = ExtResource("Script_ConversationBranch")
name = &"speak_common"
lineLocKeys = Array[StringName]([&"intro_mayor_speak_common_01"])
exitGroup = &"topics"

[sub_resource type="Resource" id="Branch_shipwreck"]
script = ExtResource("Script_ConversationBranch")
name = &"shipwreck"
lineLocKeys = Array[StringName]([&"intro_mayor_shipwreck_01"])
exitGroup = &"topics"

[sub_resource type="Resource" id="Branch_village"]
script = ExtResource("Script_ConversationBranch")
name = &"village"
lineLocKeys = Array[StringName]([&"intro_mayor_village_01"])
exitGroup = &"topics"

[sub_resource type="Resource" id="Branch_sanctuary"]
script = ExtResource("Script_ConversationBranch")
name = &"sanctuary"
lineLocKeys = Array[StringName]([&"intro_mayor_sanctuary_01"])
exitGroup = &"topics"

[sub_resource type="Resource" id="Resp_topics_1"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"intro_mayor_topics_speak_common"
language = ExtResource("Lang_common")
condition = ExtResource("Cond_language_incomplete")
destination = &"speak_common"

[sub_resource type="Resource" id="Resp_topics_2"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"intro_mayor_topics_shipwreck"
destination = &"shipwreck"

[sub_resource type="Resource" id="Resp_topics_3"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"intro_mayor_topics_village"
destination = &"village"

[sub_resource type="Resource" id="Resp_topics_4"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"intro_mayor_topics_sanctuary"
destination = &"sanctuary"

[sub_resource type="Resource" id="Group_topics"]
script = ExtResource("Script_ConversationResponseGroup")
name = &"topics"
responses = [SubResource("Resp_topics_1"), SubResource("Resp_topics_2"), SubResource("Resp_topics_3"), SubResource("Resp_topics_4")]

[resource]
script = ExtResource("Script_ConversationData")
entryBranches = [SubResource("Entry_1")]
branches = [SubResource("Branch_greeting"), SubResource("Branch_speak_common"), SubResource("Branch_shipwreck"), SubResource("Branch_village"), SubResource("Branch_sanctuary")]
responseGroups = [SubResource("Group_topics")]
