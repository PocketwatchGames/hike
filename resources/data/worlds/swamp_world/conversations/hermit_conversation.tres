[gd_resource type="Resource" script_class="ConversationData" format=3 uid="uid://w5olwf3iq444"]

[ext_resource type="Script" uid="uid://cr2wgt6ot73qr" path="res://scripts/data/conversation/ConversationData.cs" id="Script_ConversationData"]
[ext_resource type="Script" uid="uid://ce227yp5q1min" path="res://scripts/data/conversation/ConversationBranch.cs" id="Script_ConversationBranch"]
[ext_resource type="Script" uid="uid://drrpmtebgfwg0" path="res://scripts/data/conversation/ConversationLine.cs" id="Script_ConversationLine"]
[ext_resource type="Script" uid="uid://clcxqaw418g6o" path="res://scripts/data/conversation/ConversationEntry.cs" id="Script_ConversationEntry"]
[ext_resource type="Script" uid="uid://yrv1dwid3oww" path="res://scripts/data/conversation/ConversationResponse.cs" id="Script_ConversationResponse"]
[ext_resource type="Script" uid="uid://bh2srai2t6pst" path="res://scripts/data/conversation/ConversationResponseGroup.cs" id="Script_ConversationResponseGroup"]
[ext_resource type="Resource" path="res://resources/data/dialogue_scripts/actions/recruit_to_party.tres" id="Act_recruit_to_party"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("Script_ConversationEntry")
branch = &"greeting"

[sub_resource type="Resource" id="Line_greeting_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_greeting_01"

[sub_resource type="Resource" id="Line_greeting_2"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_greeting_02"

[sub_resource type="Resource" id="Branch_greeting"]
script = ExtResource("Script_ConversationBranch")
name = &"greeting"
lines = [SubResource("Line_greeting_1"), SubResource("Line_greeting_2")]
exitGroup = &"topics"
isPrimaryGroupEntry = true

[sub_resource type="Resource" id="Line_who_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_who_01"

[sub_resource type="Resource" id="Branch_who"]
script = ExtResource("Script_ConversationBranch")
name = &"who"
lines = [SubResource("Line_who_1")]
exitGroup = &"topics"

[sub_resource type="Resource" id="Line_marsh_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_marsh_01"

[sub_resource type="Resource" id="Branch_marsh"]
script = ExtResource("Script_ConversationBranch")
name = &"marsh"
lines = [SubResource("Line_marsh_1")]
exitGroup = &"topics"

[sub_resource type="Resource" id="Line_join_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_join_01"
completeActions = Array[Object]([ExtResource("Act_recruit_to_party")])

[sub_resource type="Resource" id="Branch_join"]
script = ExtResource("Script_ConversationBranch")
name = &"join"
lines = [SubResource("Line_join_1")]

[sub_resource type="Resource" id="Line_farewell_1"]
script = ExtResource("Script_ConversationLine")
locKey = &"hermit_farewell_01"

[sub_resource type="Resource" id="Branch_farewell"]
script = ExtResource("Script_ConversationBranch")
name = &"farewell"
lines = [SubResource("Line_farewell_1")]

[sub_resource type="Resource" id="Resp_topics_1"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"hermit_topics_who"
destination = &"who"

[sub_resource type="Resource" id="Resp_topics_2"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"hermit_topics_marsh"
destination = &"marsh"

[sub_resource type="Resource" id="Resp_topics_3"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"hermit_topics_join"
destination = &"join"

[sub_resource type="Resource" id="Resp_topics_4"]
script = ExtResource("Script_ConversationResponse")
textLocKey = &"hermit_topics_farewell"
destination = &"farewell"

[sub_resource type="Resource" id="Group_topics"]
script = ExtResource("Script_ConversationResponseGroup")
name = &"topics"
responses = [SubResource("Resp_topics_1"), SubResource("Resp_topics_2"), SubResource("Resp_topics_3"), SubResource("Resp_topics_4")]

[resource]
script = ExtResource("Script_ConversationData")
entryBranches = [SubResource("Entry_1")]
branches = [SubResource("Branch_greeting"), SubResource("Branch_who"), SubResource("Branch_marsh"), SubResource("Branch_join"), SubResource("Branch_farewell")]
responseGroups = [SubResource("Group_topics")]
