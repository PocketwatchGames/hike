[gd_resource type="Resource" script_class="HabitatData" format=3 uid="uid://dlivcjsyjisjg"]

[ext_resource type="Script" uid="uid://bbwa7igks862i" path="res://scripts/data/world/HabitatData.cs" id="habitat_script"]
[ext_resource type="Script" uid="uid://ckoqq24nk8tsg" path="res://scripts/data/items/ItemCountRange.cs" id="bl_range"]
[ext_resource type="Script" uid="uid://c2qx7n8rkmdt5" path="res://scripts/data/items/ItemDescriptor.cs" id="bl_desc"]
[ext_resource type="Resource" path="res://resources/data/items/loot/ancient_bone.tres" id="bl_ancient_bone"]
[ext_resource type="Resource" uid="uid://s2f2qpedbhfw" path="res://resources/data/items/loot/oil_droplet.tres" id="bl_oil_droplet"]

[sub_resource type="Resource" id="BlDesc_oil_droplet"]
