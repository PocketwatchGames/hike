[resource]
script = ExtResource("1_s")
scenarioName = "shockwave"
description = "Shockwave scroll, three casts of reagents, and a ring of goblins to knock back."
commands = "// No verb attunes a spell: read the scroll, then attune Shockwave at a campfire.
give scroll_shockwave
give goblin_meat 3
give mushroom_gold 6
spawn goblin_forest 4"
