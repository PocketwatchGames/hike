[resource]
script = ExtResource("1_s")
scenarioName = "salvage"
description = "Salvageable gear at your feet: a saber, plate armor, a blunderbuss, a musket, a pistol, an air rifle, a bow, and leather and fur armor. Salvage them at a crafting bench; each yields the materials it is repaired with, into the stash."
commands = "spawn_loot saber 1
spawn_loot plate_armor 1
spawn_loot blunderbuss 1
spawn_loot musket 1
spawn_loot pistol 1
spawn_loot air_rifle 1
spawn_loot bow 1
spawn_loot leather_armor 1
spawn_loot fur_coat 1"
