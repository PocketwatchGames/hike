[resource]
script = ExtResource("1_s")
scenarioName = "meat"
description = "One of every creature with meat. Kill each: it drops exactly one piece of its meat on top of its other loot, and two pieces of the same meat take two slots. The corpse offers no prompt. Salvage a piece at a crafting bench for its hide, bone, sinew, feather or silk."
commands = "spawn_mob goblin_forest 1
spawn_mob troll_forest 1
spawn_mob kun_kun_forest 1
spawn_mob spider_forest 1
spawn_mob drake_mountain 1
spawn_mob sparrow_forest 1
spawn_mob lurker_swamp 1"
