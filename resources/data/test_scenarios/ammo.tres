[gd_resource type="Resource" script_class="TestScenarioData" format=3]

[ext_resource type="Script" uid="uid://ctiaf4vfszxoh" path="res://scripts/data/world/TestScenarioData.cs" id="1_s"]

[resource]
script = ExtResource("1_s")
scenarioName = "ammo"
description = "A bow with plain and fire arrows, a pistol with lead balls, and goblins. Ammo is an equip slot: equip the fire arrows to fire them, and the HUD counts the slot plus every carried stack of the same kind. When they run out the slot refills with plain arrows. Swap to the pistol and its lead balls are swapped in. Rounds land as pickups; some break."
commands = "spawn_loot bow 1
spawn_loot arrow 10
spawn_loot fire_arrow 5
spawn_loot pistol 1
spawn_loot lead_ball 10
spawn_mob goblin_forest 3"
metadata/_custom_type_script = "uid://ctiaf4vfszxoh"
