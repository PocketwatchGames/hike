[gd_resource type="Resource" script_class="BrainData" format=3 uid="uid://syb6453ftgs8"]

[ext_resource type="Script" uid="uid://ctcx3rsnl61pe" path="res://scripts/data/BrainData.cs" id="1_brain"]
[ext_resource type="Script" uid="uid://8b11ol55m1y8" path="res://scripts/data/BehaviorNode.cs" id="2_node"]
[ext_resource type="Script" uid="uid://6xs48do3vkin" path="res://scripts/data/behaviors/IdleBehaviorData.cs" id="3_idle"]
[ext_resource type="Script" uid="uid://ck42hl8ho2ike" path="res://scripts/data/BehaviorNodeTransition.cs" id="4_transition"]
[ext_resource type="Script" uid="uid://cq57gys23wvvh" path="res://scripts/data/behaviors/conditions/AggroAcquiredCondition.cs" id="5_aggro_acquired"]
[ext_resource type="Script" uid="uid://bj36ge53ur48e" path="res://scripts/data/behaviors/conditions/AggroLostCondition.cs" id="6_aggro_lost"]
[ext_resource type="Script" uid="uid://drpm3lmw62rmu" path="res://scripts/data/behaviors/FleeBehaviorData.cs" id="7_flee"]
[ext_resource type="Script" uid="uid://b34r1kblkugu0" path="res://scripts/data/behaviors/BurrowBehaviorData.cs" id="8_burrow"]
[ext_resource type="Script" uid="uid://uwvia1l0j0cx" path="res://scripts/data/behaviors/conditions/CanBurrowAndOutOfRangeCondition.cs" id="9_burrow_cond"]

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("3_idle")

[sub_resource type="Resource" id="Resource_cond_aggro_acquired"]
script = ExtResource("5_aggro_acquired")

[sub_resource type="Resource" id="Resource_idle_to_flee"]
script = ExtResource("4_transition")
condition = SubResource("Resource_cond_aggro_acquired")
destination = &"Flee"

[sub_resource type="Resource" id="Resource_idle_node"]
script = ExtResource("2_node")
name = &"Idle"
data = SubResource("Resource_idle")
transitions = [SubResource("Resource_idle_to_flee")]

[sub_resource type="Resource" id="Resource_flee"]
script = ExtResource("7_flee")
fleeRange = 12.0

[sub_resource type="Resource" id="Resource_cond_burrow"]
script = ExtResource("9_burrow_cond")

[sub_resource type="Resource" id="Resource_flee_to_burrow"]
script = ExtResource("4_transition")
condition = SubResource("Resource_cond_burrow")
destination = &"Burrow"

[sub_resource type="Resource" id="Resource_cond_aggro_lost"]
script = ExtResource("6_aggro_lost")

[sub_resource type="Resource" id="Resource_flee_to_idle"]
script = ExtResource("4_transition")
condition = SubResource("Resource_cond_aggro_lost")
destination = &"Idle"

[sub_resource type="Resource" id="Resource_flee_node"]
script = ExtResource("2_node")
name = &"Flee"
data = SubResource("Resource_flee")
transitions = [SubResource("Resource_flee_to_burrow"), SubResource("Resource_flee_to_idle")]

[sub_resource type="Resource" id="Resource_burrow"]
script = ExtResource("8_burrow")

[sub_resource type="Resource" id="Resource_burrow_to_idle"]
script = ExtResource("4_transition")
condition = SubResource("Resource_cond_aggro_lost")
destination = &"Idle"

[sub_resource type="Resource" id="Resource_burrow_node"]
script = ExtResource("2_node")
name = &"Burrow"
data = SubResource("Resource_burrow")
transitions = [SubResource("Resource_burrow_to_idle")]

[resource]
script = ExtResource("1_brain")
idleBehavior = &"Idle"
behaviors = [SubResource("Resource_idle_node"), SubResource("Resource_flee_node"), SubResource("Resource_burrow_node")]
metadata/_custom_type_script = "uid://ctcx3rsnl61pe"
