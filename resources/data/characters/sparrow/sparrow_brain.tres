[gd_resource type="Resource" script_class="BrainData" format=3 uid="uid://fvs72bqjuve5"]

[ext_resource type="Script" uid="uid://bftakwiwgw6ef" path="res://scripts/data/behaviors/PerchBehaviorData.cs" id="1_perch"]
[ext_resource type="Script" uid="uid://d3xbi1dqweahm" path="res://scripts/data/behaviors/BehaviorNode.cs" id="2_node"]
[ext_resource type="Script" uid="uid://d3thrtwd1n5kq" path="res://scripts/data/behaviors/conditions/ThreatWithinDistanceCondition.cs" id="3_threat"]
[ext_resource type="Script" uid="uid://bwn2kkju73s55" path="res://scripts/data/behaviors/BehaviorNodeTransition.cs" id="4_trans"]
[ext_resource type="Script" uid="uid://ujsevbhnpl0k" path="res://scripts/data/behaviors/FlyFleeBehaviorData.cs" id="5_flyflee"]
[ext_resource type="Script" uid="uid://ctcx3rsnl61pe" path="res://scripts/data/characters/BrainData.cs" id="6_brain"]
[ext_resource type="Script" uid="uid://fl4vgm566vea" path="res://scripts/data/behaviors/LookAtBehaviorData.cs" id="7_lookat"]
[ext_resource type="Script" uid="uid://1ungofthkhct" path="res://scripts/data/behaviors/conditions/HasInvestigationCondition.cs" id="8_hasinv"]
[ext_resource type="Script" uid="uid://6hv6e7g1pnbe" path="res://scripts/data/behaviors/conditions/IncomingProjectileCondition.cs" id="9_incoming"]

[sub_resource type="Resource" id="Resource_perch"]
script = ExtResource("1_perch")

[sub_resource type="Resource" id="Resource_cond_incoming"]
script = ExtResource("9_incoming")
requireTriggered = false

[sub_resource type="Resource" id="Resource_perch_to_flee_shot"]
script = ExtResource("4_trans")
condition = SubResource("Resource_cond_incoming")
destination = &"FlyFlee"

[sub_resource type="Resource" id="Resource_cond_threat"]
script = ExtResource("3_threat")

[sub_resource type="Resource" id="Resource_perch_to_flee"]
script = ExtResource("4_trans")
condition = SubResource("Resource_cond_threat")
destination = &"FlyFlee"

[sub_resource type="Resource" id="Resource_cond_hasinv"]
script = ExtResource("8_hasinv")

[sub_resource type="Resource" id="Resource_perch_to_lookat"]
script = ExtResource("4_trans")
condition = SubResource("Resource_cond_hasinv")
destination = &"LookAt"

[sub_resource type="Resource" id="Resource_perch_node"]
script = ExtResource("2_node")
name = &"Perch"
data = SubResource("Resource_perch")
transitions = [SubResource("Resource_perch_to_flee_shot"), SubResource("Resource_perch_to_flee"), SubResource("Resource_perch_to_lookat")]

[sub_resource type="Resource" id="Resource_flyflee"]
script = ExtResource("5_flyflee")

[sub_resource type="Resource" id="Resource_flyflee_node"]
script = ExtResource("2_node")
name = &"FlyFlee"
data = SubResource("Resource_flyflee")
transitions = []

[sub_resource type="Resource" id="Resource_lookat"]
script = ExtResource("7_lookat")

[sub_resource type="Resource" id="Resource_lookat_to_flee"]
script = ExtResource("4_trans")
condition = SubResource("Resource_cond_threat")
destination = &"FlyFlee"

[sub_resource type="Resource" id="Resource_lookat_node"]
script = ExtResource("2_node")
name = &"LookAt"
data = SubResource("Resource_lookat")
transitions = [SubResource("Resource_perch_to_flee_shot"), SubResource("Resource_lookat_to_flee")]

[resource]
script = ExtResource("6_brain")
idleBehavior = &"Perch"
behaviors = [SubResource("Resource_perch_node"), SubResource("Resource_flyflee_node"), SubResource("Resource_lookat_node")]
metadata/_custom_type_script = "uid://ctcx3rsnl61pe"
