Regions = [ExtResource("3_named_mountain"), ExtResource("3_named_desert"), ExtResource("3_named_swamp"), ExtResource("3_named_forest")]
DoorScene = ExtResource("4_door")
SignpostScene = ExtResource("7_signpost")
SignpostTextNE = "The mountains rise sharp and cold ahead. Bring rope."
SignpostTextNW = "Desert. Water is scarce — fill skins before crossing."
SignpostTextSE = "Swampland. Stay on the high ground after dusk."
SignpostTextSW = "Forest path. Mind the roots, mind the wolves."
SignpostLanguage = ExtResource("6_gcffr")
KnowledgeStoneScene = ExtResource("8_stone")
KnowledgeStoneLanguage = ExtResource("6_gcffr")
KnowledgeStoneText = "Vyeshal is difficult to read. But study, my friend, and you will learn it.."
NearSpawnStashScene = ExtResource("9_chest")
NearSpawnStashItems = [SubResource("Resource_chest_loot_numbers"), SubResource("Resource_chest_loot_kunkun")]
NearSpawnBoatScene = ExtResource("12_boat")
OffCoastBoatScene = ExtResource("12_boat")
NearSpawnVillagerData = ExtResource("13_villager")
NearSpawnVillagerConversation = ExtResource("14_v_conv")
